  {
    "id": "configuration-property-keyed",
    "about": "The Hash engine then the TAC, Native and property keyed engines, named in full, without Builder and in lower case, given each setting .NET's builders read, with usage sharing off. The Hash engine indexes no property, because .NET's Hash builder has no IndexedProperties setting.",
    "configuration": {
      "PipelineOptions": {
        "Elements": [
          {
            "BuilderName": "SequenceElementBuilder"
          },
          {
            "BuilderName": "DeviceDetectionHashEngineBuilder",
            "BuildParameters": {
              "DataFile": "{dd}",
              "CreateTempDataCopy": "false",
              "AutoUpdate": "false",
              "DataFileSystemWatcher": "false",
              "DataUpdateOnStartup": "false"
            }
          },
          {
            "BuilderName": "TacEngineBuilder",
            "BuildParameters": {
              "CacheSize": "100",
              "CacheHitOrMiss": "false",
              "LazyLoadingTimeout": "1000",
              "Properties": "Profiles"
            }
          },
          {
            "BuilderName": "NativeEngine"
          },
          {
            "BuilderName": "propertykeyeddeviceenginebuilder",
            "BuildParameters": {
              "KeyProperty": "HardwareVendor",
              "ElementDataKey": "vendor-profiles"
            }
          }
        ],
        "BuildParameters": {
          "SetShareUsage": "false"
        }
      }
    }
  },
