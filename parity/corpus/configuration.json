[
  {
    "id": "configuration-pipeline",
    "about": "The Sequence element, the Hash and IP Intelligence engines in a parallel group, the JSON builder and usage sharing, with every parameter given as text, and each setting read back.",
    "configuration": {
      "PipelineOptions": {
        "Elements": [
          {
            "BuilderName": "SequenceElementBuilder"
          },
          {
            "SubElements": [
              {
                "BuilderName": "DeviceDetectionHashEngineBuilder",
                "BuildParameters": {
                  "DataFile": "{dd}",
                  "CreateTempDataCopy": "false",
                  "AutoUpdate": "false",
                  "DataFileSystemWatcher": "false",
                  "DataUpdateOnStartup": "false",
                  "UpdatePollingInterval": "00:45:00",
                  "UpdateRandomisationMax": "120",
                  "DataUpdateUrl": "https://parity.test/data",
                  "DataUpdateLicenseKey": "PARITYKEY",
                  "DataUpdateVerifyMd5": "false",
                  "DataUpdateDecompress": "false",
                  "VerifyIfModifiedSince": "false"
                }
              },
              {
                "BuilderName": "IpiOnPremiseEngineBuilder",
                "BuildParameters": {
                  "DataFile": "{ipi}",
                  "CreateTempDataCopy": "false",
                  "AutoUpdate": "false",
                  "DataFileSystemWatcher": "false",
                  "DataUpdateOnStartup": "false"
                }
              }
            ]
          },
          {
            "BuilderName": "JsonBuilderElementBuilder"
          },
          {
            "BuilderName": "ShareUsageBuilder",
            "BuildParameters": {
              "SharePercentage": "0.5",
              "MinimumEntriesPerMessage": "20",
              "MaximumQueueSize": "500",
              "AddTimeout": "10",
              "TakeTimeout": "200",
              "ShareUsageUrl": "https://parity.test/usage",
              "BlockedHttpHeaders": "Referer,X-Forwarded-For",
              "IncludedQueryStringParameters": "utm_source,utm_medium",
              "IgnoreFlowDataEvidenceFilter": "header.x-health-check:true",
              "ShareAllEvidence": "false",
              "RepeatEvidenceIntervalMinutes": "5"
            }
          }
        ],
        "BuildParameters": {
          "SuppressProcessExceptions": "true"
        }
      }
    }
  },
