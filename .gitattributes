# Files read by bash keep LF on every platform. A carriage return stops a
# script at its first line, and in the crate list it is added to every crate
# name, so cargo refuses a name that looks right in any error message.
*.sh        text eol=lf
ci/*.txt    text eol=lf

# The JavaScript template keeps the line endings of the shared copy it is
# taken from, so the script holds the same bytes whichever platform builds it.
javascript-builder/assets/*.mustache text eol=lf
