# Cargo build output for every workspace in the repo (root and examples/).
target/
# The copy of Cargo.lock that ci/measure-wasm-size.sh places in its crate.
/ci/wasm-size/Cargo.lock
# Performance results written by the nightly performance workflow.
/test-results
*.log
# The shared browser contract suite, shallow-cloned by
# ci/run-integration-tests.ps1 (a sibling checkout in CI, but cloned here when
# the script is run from the repo root locally).
/selenium-api-tests/
.DS_Store
Thumbs.db

# Local working directories of AI coding agents. These hold per-developer
# session state, handover notes and settings, none of which belong in the
# repository. The shared, tool-neutral handover lives in AGENTS.md at the root.
.claude/
.cursor/
.windsurf/
.aider*
.continue/
.codeium/
.gemini/
.opencode/

# The OWID source that ci/copy-owid-source.ps1 copies into the fodid crate
# before a build. The owid-rust submodule is the only copy that belongs in
# the repository.
/fodid/src/owid/

# The C sources that ci/copy-cxx-sources.ps1 copies into the -sys crates
# before packaging. The cxx submodule is the only copy that belongs in the
# repository.
/common-sys/cxx/
/device-detection-sys/cxx/
/ip-intelligence-sys/cxx/

# The translation files that ci/copy-translations.ps1 copies into the
# translation crate before packaging. The data repository inside the cxx
# submodule is the only copy that belongs in the repository.
/ip-intelligence-translation/translations/

# The derived-properties commit that ci/record-derived-properties-commit.ps1
# writes before packaging. The submodule itself records the commit in the
# repository.
/derived-properties/SOURCE.txt
